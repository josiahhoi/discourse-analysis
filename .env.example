# Copy this file to .env and fill in your own keys. .env is gitignored, so it
# never gets committed or shipped in a packaged build.
#
# These keys are read by the Electron main process only (main.js) — they never
# reach the renderer/DevTools. The static web build can't hold secrets at all;
# it uses the Firebase Cloud Function proxy instead (functions/index.js), which
# holds the same two keys as deployed secrets:
#   npx firebase-tools functions:secrets:set ESV_API_KEY
#   npx firebase-tools functions:secrets:set API_BIBLE_KEY
# Without a key/proxy, ESV and NASB quietly fall back to the keyless
# bolls.life source.

# ESV — get one free at https://api.esv.org/account/create-application/
ESV_API_KEY=

# NASB via API.Bible — get one at https://api.bible/ (free non-commercial
# tier; pick NASB as one of your translations)
API_BIBLE_KEY=

# Optional: pin the exact API.Bible bible id for NASB (skips the automatic
# lookup of the NASB edition available on your key)
API_BIBLE_NASB_ID=
