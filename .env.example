# Copy this file to .env and fill in your own key (get one free at
# https://api.esv.org/account/create-application/). .env is gitignored, so it
# never gets committed or shipped in a packaged build.
#
# Desktop (Electron) app only — see main.js. The static/GitHub Pages web build
# has no server, so it cannot hold this secret and always uses the Bolls
# fallback for ESV/NASB text instead.
ESV_API_KEY=
